{%- set pageTitle -%}{%- if title -%}{{ title }}{{ site.meta.separator }}{{ site.meta.title }}{%- else -%}{{ site.meta.title }}{{ site.meta.separator }}{{ site.meta.description }}{%- endif -%}{%- endset -%}
<!doctype html>
<html lang="en" class="bg-transparent antialiased" x-data="app" :data-theme="theme">

  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{{ pageTitle | safe }}</title>
    <meta name="description" content="{{ site.meta.description }}" />
    <meta name="author" content="{{ site.meta.author + ' - '+ site.meta.url }}" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="title" content="{{ pageTitle | safe }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.meta.url }}{{ page.url | url }}" />
    <meta property="og:title" content="{{ pageTitle | safe }}" />
    <meta property="og:description" content="{{ site.meta.description }}" />
    <meta property="og:image" content="{{ site.meta.url }}{{ '/' | url }}og-image.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="{{ site.meta.url }}{{ page.url | url }}" />
    <meta property="twitter:title" content="{{ pageTitle | safe }}" />
    <meta property="twitter:description" content="{{ site.meta.description }}" />
    <meta property="twitter:image" content="{{ site.meta.url }}{{ '/' | url }}og-image.png" />

    <link rel="icon" type="image/x-icon" href="{{ '/' | url }}{%- if favicon -%}_assets/{{ favicon }}/{%- endif -%}favicon.ico" />
    <link rel="apple-touch-icon" href="{{ '/' | url }}apple-touch-icon.png" />
    <link rel="manifest" href="{{ '/' | url }}site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link onload="this.onload=null;this.rel='stylesheet'" rel="preload" as="style" href="https://fonts.googleapis.com/css2?family={{ 'Roboto+Mono:wght@100;400;700' if '/currently/' in page.url else 'Inter:wght@100..900' }}&display=swap" />
    
    <meta name="p:domain_verify" content="8f7326aedb8678368871e5a49beaa8ac" />

    <link href="{{ '/' | url }}_assets/css/daisyui.css" rel="stylesheet" type="text/css" />
    <link href="{{ '/' | url }}_assets/css/daisyui-themes.css" rel="stylesheet" type="text/css" />
    <script src="{{ '/' | url }}_assets/js/tailwind.js"></script>
    {% include 'theme-config.njk' %}

  </head>
  <body class="!block bg-base-300 text-base-content {{- ' font-mono select-none' if '/currently/' in page.url else ' font-sans' }}" style="display: none;" data-instant-intensity="mousedown">
    <div class="app w-full min-h-screen flex flex-col relative" x-data="{% renderblock 'data' -%}">

      <div id="bg" class="bg-gradient-to-b from-transparent via-transparent to-(--color-base-100) fixed inset-0 -z-2 opacity-50" aria-hidden="true"><div class="[background-image:var(--grid)] bg-fixed absolute inset-0"></div></div>
      <div id="particles" class="particles text-current hidden fixed inset-0 -z-1 opacity-15 motion-safe:block" aria-hidden="true"></div>

      <header class="py-2 px-4 w-full text-sm shrink-0 flex items-center justify-end gap-4 md:px-8">
        {%- renderblock 'header' %}
        <div class="dropdown dropdown-end">
          <div data-cuelume-hover="tick" data-cuelume-press data-cuelume-release tabindex="0" class="btn btn-ghost btn-circle hover:[background-color:color-mix(in_oklab,currentColor_10%,transparent)]">
            <div :data-theme="theme" class="w-3/5 aspect-square p-0.5 border border-base-300 bg-base-100 grid grid-cols-2 grid-rows-2 gap-px rounded-field">
              <div class="bg-primary rounded-field"></div>
              <div class="bg-secondary rounded-field"></div>
              <div class="bg-accent rounded-field"></div>
              <div class="bg-base-content rounded-field"></div>
            </div>
          </div>
          <div tabindex="-1" class="dropdown-content my-2 border border-base-content/10 h-[30.5rem] max-h-[calc(100vh-8.6rem)] bg-base-100 overflow-y-auto rounded-box shadow-lg">
            <menu class="menu menu-sm w-52">
              <li class="menu-title text-xs uppercase">Theme</li>
              <template x-for="item in themes" hidden>
                <li>
                  <button data-cuelume-hover="tick" data-cuelume-press data-cuelume-release @click="theme = item; document.activeElement.blur();" class="capitalize" :class="item === theme && 'menu-active'">
                    <div :data-theme="item" class="w-4 h-4 p-0.5 border border-base-300 bg-base-100 grid grid-cols-2 grid-rows-2 gap-px rounded-field">
                      <div class="bg-primary rounded-field"></div>
                      <div class="bg-secondary rounded-field"></div>
                      <div class="bg-accent rounded-field"></div>
                      <div class="bg-base-content rounded-field"></div>
                    </div>
                    <span x-text="item"></span>
                    <iconify-icon x-show="item === theme" icon="mdi:check" class="iconify ml-auto" noobserver></iconify-icon>
                  </button>
                </li>
              </template>
            </menu>
          </div>
        </div>
        <nav class="dropdown dropdown-end group">
          <div data-cuelume-hover="tick" data-cuelume-press data-cuelume-release tabindex="0" class="btn btn-ghost btn-circle hover:bg-current/10" aria-controls="nav-main" role="button">
            <span class="sr-only">Menu</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="w-4 h-4 fill-current pointer-events-none">
              <rect width="9" height="2" y="7" rx="1" class="origin-center -translate-y-[5px] translate-x-[7px] group-focus-within:translate-x-0 group-focus-within:translate-y-0 group-focus-within:rotate-[315deg] motion-safe:transition-all" />
              <rect width="16" height="2" y="7" rx="1" class="origin-center group-focus-within:rotate-45 motion-safe:transition-all" />
              <rect width="9" height="2" y="7" rx="1" class="origin-center translate-y-[5px] group-focus-within:translate-y-0 group-focus-within:rotate-[135deg] motion-safe:transition-all" />
            </svg>
          </div>
          <div
            tabindex="-1"
            class="dropdown-content mx-2 border border-base-content/10 bg-base-100 rounded-box shadow-lg"
            id="nav-main">
            <menu class="menu menu-sm menu-horizontal p-1 [flex-flow:row]">
              {%- for item in collections.all | eleventyNavigation %}
              <li>
                <a href="{{ item.url | url }}" class="text-lg{% if item.url !== '/' %}{% if item.url === page.url or item.url in page.url %} menu-active{% endif %}{% endif %}"{%- if item.url === page.url or item.url in page.url %} aria-current="page"{%- endif %} data-cuelume-hover="tick">
                  <iconify-icon icon="{{ item.icon }}" noobserver></iconify-icon>
                  <b class="sr-only">{{ item.title }}</b>
                </a>
              </li>
              {%- endfor %}
            </menu>
          </div>
        </nav>
      </header>

      <main class="p-4 grow {{- ' grid grid-cols-1 gap-x-8 xl:grid-cols-3' if '/currently/' in page.url else ' flex items-center' }}">
        {{ content | safe }}
      </main>

      {%- renderblock 'footer' %}

    </div>

    {%- renderblock 'js' %}
    <script src="{{ '/' | url }}_assets/js/_app.js?v={% bust %}"></script>

  </body>

</html>
